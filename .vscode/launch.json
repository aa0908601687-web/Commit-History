      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "V6: Debug all V6 regression tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "WP-OS-Git-MAX",
        "-p",
        "test_v6_*.py",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
