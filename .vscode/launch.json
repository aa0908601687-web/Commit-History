{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "V6: Debug 8-to-6 exhaustive search tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover",
        "-s",
        "WP-OS-Git-MAX",
        "-p",
        "test_v6_exact_search.py",
        "-v"
